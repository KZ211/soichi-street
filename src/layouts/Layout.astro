---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · Chapa y pintura en Presidente Derqui`,
  description = 'Chapa, pintura, pulido y soldadura en Presidente Derqui, Pilar. Mirá trabajos reales, marcá lo que hay que arreglar y pedí presupuesto por WhatsApp.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoBodyShop',
  name: site.name,
  url: Astro.site?.href,
  image: ogImage.href,
  telephone: '+54 9 11 3140-8890',
  sameAs: [site.instagram],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Presidente Derqui',
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0a0e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_AR" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Sacramento&family=Tilt+Neon&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

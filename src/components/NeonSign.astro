---
// El cartel "Soichi Street": un tubo de vidrio de trazo fino, con los electrodos en sus puntas reales y
// un tramo pintado de negro que une las dos palabras en un solo circuito. Las posiciones se miden en el
// navegador sobre las letras ya cargadas.
interface Props {
  layout: 'one' | 'two';
  ignite?: boolean;
  class?: string;
}

const { layout, ignite = false, class: className } = Astro.props;
const lines = layout === 'one' ? [{ text: 'Soichi Street', x: 600, y: 210 }] : [
  { text: 'Soichi', x: 300, y: 190 },
  { text: 'Street', x: 300, y: 400 },
];
const viewBox = layout === 'one' ? '0 0 1200 300' : '0 0 600 470';
---

<svg class:list={['neon', { ignite }, className]} viewBox={viewBox} aria-hidden="true" data-neon>
  <g class="paint"></g>
  <g class="glass">
    {lines.map((l) => <text x={l.x} y={l.y} text-anchor="middle">{l.text}</text>)}
  </g>
  <g class="lit">
    {lines.map((l) => <text x={l.x} y={l.y} text-anchor="middle">{l.text}</text>)}
  </g>
  <g class="electrodes"></g>
</svg>

<script>
  const NS = 'http://www.w3.org/2000/svg';

  function el(name: string, attrs: Record<string, string | number>) {
    const node = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    return node;
  }

  function build(svg: SVGSVGElement) {
    const texts = [...svg.querySelectorAll<SVGTextElement>('.glass text')];
    // Cada palabra: la caja de su primera y su última letra.
    const words: { first: DOMRect; last: DOMRect; base: number }[] = [];
    for (const t of texts) {
      const base = Number(t.getAttribute('y'));
      const str = t.textContent ?? '';
      let start = -1;
      for (let i = 0; i <= str.length; i++) {
        const space = i === str.length || str[i] === ' ';
        if (!space && start < 0) start = i;
        if (space && start >= 0) {
          words.push({ first: t.getExtentOfChar(start), last: t.getExtentOfChar(i - 1), base });
          start = -1;
        }
      }
    }
    if (!words.length) return;

    const paint = svg.querySelector('.paint')!;
    const electrodes = svg.querySelector('.electrodes')!;
    paint.replaceChildren();
    electrodes.replaceChildren();

    // Los trazos de esta letra terminan sobre la línea de base: ahí van las puntas del tubo.
    const end = (w: { base: number }) => w.base - 8;

    // Tramo pintado entre dos palabras de la misma línea (en dos líneas el tubo vuelve por detrás)
    for (let i = 0; i < words.length - 1; i++) {
      if (words[i].base !== words[i + 1].base) continue;
      const a = words[i].last;
      const b = words[i + 1].first;
      const x1 = a.x + a.width * 0.85;
      const y1 = end(words[i]);
      const x2 = b.x + b.width * 0.15;
      const y2 = end(words[i + 1]);
      const sag = y1 === y2 ? 10 : Math.abs(y2 - y1) * 0.2;
      const d = `M${x1} ${y1} C ${x1 + 40} ${y1 + sag}, ${x2 - 40} ${y2 + sag}, ${x2} ${y2}`;
      paint.append(el('path', { d }));
    }

    // Electrodos en la punta de entrada y en la de salida
    const first = words[0].first;
    const last = words[words.length - 1].last;
    // La caja de cada letra incluye su avance; la tinta real se mide con el mismo cuerpo en un canvas.
    const lastWord = words[words.length - 1];
    const ctx = document.createElement('canvas').getContext('2d');
    let inkLeft = first.x;
    let inkRight = last.x + last.width;
    if (ctx) {
      const size = getComputedStyle(texts[0]).fontSize;
      ctx.font = `${size} Sacramento`;
      const str = (texts[0].textContent ?? '').trim();
      const lastStr = (texts[texts.length - 1].textContent ?? '').trim();
      inkLeft = first.x - ctx.measureText(str[0]).actualBoundingBoxLeft;
      inkRight = last.x + ctx.measureText(lastStr[lastStr.length - 1]).actualBoundingBoxRight;
    }
    // La cola de la S y la de la t terminan unos 25 px hacia adentro de su caja de tinta.
    electrodes.append(el('rect', { x: inkLeft + 8, y: end(words[0]) - 5, width: 22, height: 10, rx: 3 }));
    electrodes.append(el('rect', { x: inkRight - 32, y: end(lastWord) - 5, width: 22, height: 10, rx: 3 }));
  }

  const signs = document.querySelectorAll<SVGSVGElement>('[data-neon]');
  const run = () => signs.forEach((s) => s.getClientRects().length && build(s));
  document.fonts.load('200px Sacramento').then(run, run);
  window.addEventListener('resize', run);
</script>

<style>
  .neon {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .neon text {
    font-family: var(--font-script);
    font-size: 210px;
  }

  .neon .glass text {
    fill: rgb(221 230 242 / 0.22);
  }

  .neon .lit {
    filter: drop-shadow(0 0 2px var(--neon)) drop-shadow(0 0 12px rgb(255 63 164 / 0.75)); /* taste-skill-ignore: the gas discharge itself */
  }

  .neon .lit text {
    fill: var(--neon-core);
  }

  .neon :global(.paint path) {
    fill: none;
    stroke: #2a2230;
    stroke-width: 6;
    stroke-linecap: round;
  }

  .neon :global(.electrodes rect) {
    fill: var(--electrode);
  }


  /* Encendido: el vidrio aparece de izquierda a derecha y después el gas prende con un parpadeo */
  @media (prefers-reduced-motion: no-preference) {
    .ignite .glass {
      clip-path: inset(0 100% 0 0);
      animation: bend 1.2s var(--ease-out) 0.15s forwards;
    }

    .ignite .lit {
      opacity: 0;
      animation: ignite 1.1s 1.4s steps(1, end) forwards;
    }

    .ignite :global(.electrodes rect) {
      opacity: 0;
      animation: on 0.25s 1.25s forwards;
    }
  }

  @keyframes bend {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes on {
    to {
      opacity: 1;
    }
  }

  @keyframes ignite {
    0% { opacity: 1; }
    12% { opacity: 0; }
    22% { opacity: 1; }
    30% { opacity: 0; }
    46% { opacity: 1; }
    54% { opacity: 0.45; }
    64%, 100% { opacity: 1; }
  }
</style>
